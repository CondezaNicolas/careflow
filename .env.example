# =============================================================================
# LIA Clinic Core - Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in the values for your environment.
# DO NOT commit actual secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Core
# -----------------------------------------------------------------------------
NODE_ENV=development

# Database - PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://lia:lia@localhost:5432/lia_clinic

# Redis - Session/cache store
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Object Storage (MinIO/S3-compatible)
# -----------------------------------------------------------------------------
# Endpoint for local development (MinIO default)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# Access credentials - obtain from your MinIO/S3 admin console
OBJECT_STORAGE_ACCESS_KEY=lia
OBJECT_STORAGE_SECRET_KEY=lia-clinic-secret

# -----------------------------------------------------------------------------
# OIDC Authentication (Auth0, Okta, Keycloak, etc.)
# -----------------------------------------------------------------------------
# Your OIDC provider's issuer URL
OIDC_ISSUER=https://example-tenant.auth0.com/
# Application credentials - obtain from your OIDC provider's dashboard
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me
# Authorized redirect URI after login
OIDC_REDIRECT_URI=https://localhost:3001/auth/callback
# Audience claim for token validation
OIDC_AUDIENCE=replace-me
# Custom claims mapping
OIDC_TENANT_CLAIM=tenant_id
OIDC_ROLE_CLAIM=role

# -----------------------------------------------------------------------------
# Session Configuration
# -----------------------------------------------------------------------------
SESSION_COOKIE_NAME=lia_session
# Session time-to-live in minutes (480 = 8 hours)
SESSION_TTL_MINUTES=480

# -----------------------------------------------------------------------------
# Google Calendar Integration
# -----------------------------------------------------------------------------
# Obtain from Google Cloud Console - OAuth 2.0 credentials
GOOGLE_CALENDAR_CLIENT_ID=replace-me
GOOGLE_CALENDAR_CLIENT_SECRET=replace-me
# Refresh token obtained via OAuth flow
GOOGLE_CALENDAR_REFRESH_TOKEN=replace-me
# Calendar ID to use (usually "primary")
GOOGLE_CALENDAR_CALENDAR_ID=primary

# -----------------------------------------------------------------------------
# Email Provider (SendGrid, Postmark, Resend, etc.)
# -----------------------------------------------------------------------------
# API key from your email provider
EMAIL_PROVIDER_API_KEY=replace-me
# Default sender address for transactional emails
EMAIL_PROVIDER_FROM=noreply@example.com

# -----------------------------------------------------------------------------
# WhatsApp Business API (Meta)
# -----------------------------------------------------------------------------
# Obtain from Meta Developer Portal
WHATSAPP_ACCESS_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me
WHATSAPP_BUSINESS_ACCOUNT_ID=replace-me

# -----------------------------------------------------------------------------
# AI Provider (OpenAI, Anthropic, etc.) - Optional
# -----------------------------------------------------------------------------
# For AI assistant features - set if using LLM-powered tools
# OPENAI_API_KEY=replace-me
# ANTHROPIC_API_KEY=replace-me
