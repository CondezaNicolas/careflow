# =============================================================================
# LIA Clinic Core - Backend environment template
# =============================================================================
# Copy this file to `.env.local` for local API development.
# Production must provide real secrets and integration credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
API_PORT=3001
ENABLE_REQUEST_LOGGING=true
ALLOWED_ORIGINS=http://localhost:3310,http://localhost:3000
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_GRACE_PERIOD_MS=10000

# -----------------------------------------------------------------------------
# Infrastructure
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://lia:lia@localhost:5432/lia_clinic
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Abuse controls
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# JWT authentication
# -----------------------------------------------------------------------------
# Development defaults exist for local startup only.
# Production MUST override these with strong random values.
JWT_SECRET=dev-jwt-secret-please-override-in-production-32ch!
JWT_REFRESH_SECRET=dev-refresh-secret-please-override-in-production-32ch!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# -----------------------------------------------------------------------------
# Session cookie policy
# -----------------------------------------------------------------------------
SESSION_COOKIE_NAME=lia_session
SESSION_SECRET=dev-session-secret-please-override-in-production-32ch!

# -----------------------------------------------------------------------------
# Explicit local-only auth shortcuts
# -----------------------------------------------------------------------------
AUTH_DEV_BYPASS=false
DEV_LOGIN_ENABLED=false

# -----------------------------------------------------------------------------
# Optional provider integrations
# These are visible in `/health/ready` and `/ops/diagnostics`.
# In production they are required for readiness.
# -----------------------------------------------------------------------------
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_CALENDAR_ID=

EMAIL_PROVIDER_API_KEY=
EMAIL_PROVIDER_FROM=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# Worker delivery behavior
# -----------------------------------------------------------------------------
GOOGLE_CALENDAR_MAX_RETRIES=5
GOOGLE_CALENDAR_BACKOFF_SECONDS=30
NOTIFICATIONS_MAX_RETRIES=4
NOTIFICATIONS_BACKOFF_SECONDS=45
