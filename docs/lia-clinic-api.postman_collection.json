{
  "info": {
    "name": "LIA Clinic API",
    "description": "Collection for testing LIA Clinic API with native JWT auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3311"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Login (JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
                  "",
                  "pm.test('Has accessToken', function() {",
                  "    pm.expect(jsonData).to.have.property('accessToken');",
                  "});",
                  "",
                  "pm.test('Has refreshToken', function() {",
                  "    pm.expect(jsonData).to.have.property('refreshToken');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@lia.local\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "protocol": "http",
              "host": ["localhost:3311"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@lia.local\",\n  \"password\": \"NewUser123!\",\n  \"role\": \"clinician\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "protocol": "http",
              "host": ["localhost:3311"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "pm.collectionVariables.set('refreshToken', jsonData.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "protocol": "http",
              "host": ["localhost:3311"],
              "path": ["auth", "refresh"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "protocol": "http",
              "host": ["localhost:3311"],
              "path": ["auth", "logout"]
            }
          }
        },
        {
          "name": "Dev Login (Bypass - Solo Local)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/dev-login?role=admin",
              "protocol": "http",
              "host": ["localhost:3311"],
              "path": ["auth", "dev-login"],
              "query": [{ "key": "role", "value": "admin" }]
            }
          }
        },
        {
          "name": "Dev Login - Clinician",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/dev-login?role=clinician",
              "protocol": "http",
              "host": ["localhost:3311"],
              "path": ["auth", "dev-login"],
              "query": [{ "key": "role", "value": "clinician" }]
            }
          }
        },
        {
          "name": "Dev Login - Receptionist",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/dev-login?role=receptionist",
              "protocol": "http",
              "host": ["localhost:3311"],
              "path": ["auth", "dev-login"],
              "query": [{ "key": "role", "value": "receptionist" }]
            }
          }
        },
        {
          "name": "Dev Login - Patient",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/dev-login?role=patient",
              "protocol": "http",
              "host": ["localhost:3311"],
              "path": ["auth", "dev-login"],
              "query": [{ "key": "role", "value": "patient" }]
            }
          }
        }
      ]
    },
    {
      "name": "🏥 Patients",
      "item": [
        {
          "name": "Get Patient Chart",
          "request": {
            "auth": { "type": "bearer" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/patients/:id/chart",
              "protocol": "http",
              "host": ["localhost:3311"],
              "path": ["patients", ":id", "chart"]
            }
          }
        }
      ]
    },
    {
      "name": "📅 Scheduling",
      "item": [
        {
          "name": "Get Availability",
          "request": {
            "auth": { "type": "bearer" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/scheduling/availability?specialistId=usr-1&from=2026-04-01T09:00:00Z&to=2026-04-01T12:00:00Z&durationMinutes=30",
              "protocol": "http",
              "host": ["localhost:3311"],
              "path": ["scheduling", "availability"],
              "query": [
                { "key": "specialistId", "value": "usr-1" },
                { "key": "from", "value": "2026-04-01T09:00:00Z" },
                { "key": "to", "value": "2026-04-01T12:00:00Z" },
                { "key": "durationMinutes", "value": "30" }
              ]
            }
          }
        },
        {
          "name": "Create Appointment",
          "request": {
            "auth": { "type": "bearer" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "idempotency-key", "value": "appt-create-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"patient-uuid\",\n  \"specialistId\": \"usr-1\",\n  \"startAtIso\": \"2026-04-01T10:00:00Z\",\n  \"endAtIso\": \"2026-04-01T10:30:00Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/scheduling/appointments",
              "protocol": "http",
              "host": ["localhost:3311"],
              "path": ["scheduling", "appointments"]
            }
          }
        }
      ]
    },
    {
      "name": "🩺 Clinical",
      "item": [
        {
          "name": "Create Encounter",
          "request": {
            "auth": { "type": "bearer" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"patient-uuid\",\n  \"startedAtIso\": \"2026-04-01T09:00:00Z\",\n  \"endedAtIso\": \"2026-04-01T09:30:00Z\",\n  \"reason\": \"Follow-up consultation\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/clinical/encounters",
              "protocol": "http",
              "host": ["localhost:3311"],
              "path": ["clinical", "encounters"]
            }
          }
        },
        {
          "name": "Get Patient Timeline",
          "request": {
            "auth": { "type": "bearer" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/clinical/patients/:patientId/timeline?visibilityScope=patient_shared&limit=20&offset=0",
              "protocol": "http",
              "host": ["localhost:3311"],
              "path": ["clinical", "patients", ":patientId", "timeline"],
              "query": [
                { "key": "visibilityScope", "value": "patient_shared" },
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "🧪 Exams",
      "item": [
        {
          "name": "Create Exam Order",
          "request": {
            "auth": { "type": "bearer" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"patient-uuid\",\n  \"examType\": \"bloodwork\",\n  \"notes\": \"Fasting required\",\n  \"attachments\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/exams",
              "protocol": "http",
              "host": ["localhost:3311"],
              "path": ["exams"]
            }
          }
        },
        {
          "name": "Get Patient Exams",
          "request": {
            "auth": { "type": "bearer" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/exams/patients/:patientId?visibilityScope=patient_visible",
              "protocol": "http",
              "host": ["localhost:3311"],
              "path": ["exams", "patients", ":patientId"],
              "query": [{ "key": "visibilityScope", "value": "patient_visible" }]
            }
          }
        }
      ]
    },
    {
      "name": "🏥 Patient Portal",
      "item": [
        {
          "name": "My Overview",
          "request": {
            "auth": { "type": "bearer" },
