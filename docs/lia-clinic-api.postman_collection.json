            }
          }
        }
      ]
    },
    {
      "name": "💬 LIA Assistant",
      "item": [
        {
          "name": "Invoke Tool",
          "request": {
            "auth": { "type": "bearer" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": {\n    \"specialistId\": \"usr-1\",\n    \"fromIso\": \"2026-04-01T09:00:00Z\",\n    \"toIso\": \"2026-04-01T12:00:00Z\",\n    \"durationMinutes\": 30\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/lia-assistant/tools/availability.search/invoke",
              "protocol": "http",
              "host": ["localhost:3311"],
              "path": ["lia-assistant", "tools", "availability.search", "invoke"]
            }
          }
        }
      ]
    },
    {
      "name": "🖥️ Ops (Admin)",
      "item": [
